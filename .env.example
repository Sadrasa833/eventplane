# Django
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL (must match the db service in docker-compose.yml)
POSTGRES_DB=eventplanet
POSTGRES_USER=eventplanet
POSTGRES_PASSWORD=eventplanet
POSTGRES_PORT=5432

# Frontend origins allowed to call this API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base URL the built frontend will call (baked in at frontend build time)
FRONTEND_API_BASE_URL=http://localhost:8000/api
